# ---------------------------------------------------------------------------
# EduREVIVE OUTREACH — form delivery
#
# Copy to .env.local and fill in ONE of the two transports below. With neither
# set, submissions are printed to the server console in development and are
# rejected in production.
# ---------------------------------------------------------------------------

# --- Option 1: email via Resend (https://resend.com) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=hello@edurevive.org
# CONTACT_FROM_EMAIL=website@edurevive.org   # must be a Resend-verified domain

# --- Option 2: POST submissions as JSON (Slack, Zapier, Make, a CRM…) ---
# FORM_WEBHOOK_URL=https://hooks.example.com/edurevive
